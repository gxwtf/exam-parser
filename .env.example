# API 类型: openai（默认）或 anthropic
API_TYPE=openai

# ===== 默认：本机 API（new-api 网关 → 本机 vLLM 集群，离线/免费/上下文 1M）=====
OPENAI_BASE_URL=http://localhost:8080/v1
# 本机网关的 key 找运维/群内要（不在仓库里放真 key）
OPENAI_API_KEY=your_new_api_key_here
OPENAI_MODEL=deepseek-v4.1-flash

# 请求超时（秒）。本地推理生成整卷 JSON 较慢，默认放宽到 600
OPENAI_TIMEOUT=600

# 单次回复上限（含思考 token）
OPENAI_MAX_TOKENS=32000

# 思考等级："none" 关闭思考（本机模型必须显式传，不传=思考全开、会烧光 max_tokens 导致 content 为空）
# 想开思考可设 low/high/xhigh/max；留空则完全不传该参数
OPENAI_REASONING_EFFORT=none

# Optional: Set logging level
# LOG_LEVEL=INFO

# ===== 备选：本机网关公网入口（同一网关，走 ai.gxwtf.cn）=====
# OPENAI_BASE_URL=https://ai.gxwtf.cn/v1
# OPENAI_MODEL=DeepSeek-V4-Flash-0731

# ===== 备选：官方付费 API =====
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=deepseek-flash
